# 复制为 .env 后按需修改（不提交到 git）

# 数据库文件位置（默认 data/floodsentinel.db）
FLOOD_DB_PATH=data/floodsentinel.db

# 或直接给 SQLAlchemy 连接串（换 PostgreSQL 时用这个）
# FLOOD_DB_URL=postgresql+psycopg://user:pass@localhost:5432/floodsentinel

# 允许跨域的前端地址，逗号分隔
FLOOD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# W3 之后由李宇露填写
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=qwen2.5-7b-instruct
